{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "Personal pi coding-agent extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/bash-background.ts",
      "./extensions/bash-duration.ts",
      "./extensions/google-search.ts",
      "./extensions/block-web-search.ts",
      "./extensions/persistent-history.ts",
      "./extensions/turn-timer.ts"
    ]
  },
  "keywords": ["pi", "pi-coding-agent", "extensions"],
  "license": "MIT",
  "author": "Fabian <fabian@schlieper.email>",
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.12.4",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  }
}
